# ---- Python and tooling
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
htmlcov/

# ---- operating system and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- what vmd-agent writes while it runs (never commit a user's data or results)
/data/
/pdb_cache/
/structures/
/vmd_agent_output/
/bench_out/
/agent_bench_out/
vmd_scripts/

# ---- anything that could hold a secret
.env
.env.*
/config/
settings.json

# ---- VMD itself must never be committed (UIUC licence); only the drop-folder's README is kept
docker/vmd-dist/*
!docker/vmd-dist/README.md

# ---- vmd-agent's own data folder in a working folder: settings (may hold an API key), the window link's token and the
#      downloaded model server and model files (many GB). It also ignores itself; this keeps it out even if that file is lost.
.vmd-agent/
/ollama/
*.gguf
*.safetensors
